# Opzionale: abilita recensioni/verifiche persistenti.
# Crea un database Upstash Redis dal Marketplace Vercel (piano free):
# le variabili vengono iniettate automaticamente nel progetto.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Salt per l'hash anonimo degli IP usato nel rate-limit (stringa casuale lunga)
RATE_LIMIT_SALT=
# Protegge /api/cron/refresh (Vercel lo invia come Bearer token)
CRON_SECRET=
# Titolare del trattamento mostrato nell'informativa privacy (obbligatorio prima della pubblicazione)
PUBLIC_OWNER_NAME=
PUBLIC_OWNER_EMAIL=
# Dominio pubblico per URL canonici, Open Graph e sitemap (es. https://puliziastrade.firenze.it).
# Se vuoto su Vercel si usa il dominio di produzione del progetto.
PUBLIC_SITE_URL=
